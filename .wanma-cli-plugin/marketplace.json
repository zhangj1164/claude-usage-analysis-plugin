{
  "name": "wanma-usage-analysis-plugin",
  "owner": {
    "name": "zhangj1164",
    "email": "zhangj1164@chinaunicom.cn"
  },
  "metadata": {
    "description": "Wanma Code 使用分析系统 - 帮助团队自动采集、分析使用数据，持续优化 Wanma Code 使用体验的完整解决方案",
    "version": "2.3.0",
    "tags": [
      "analytics",
      "productivity",
      "team",
      "monitoring",
      "improvement"
    ],
    "icon": "./assets/icon.svg"
  },
  "plugins": [
    {
      "name": "usage-analytics",
      "description": "Complete usage analytics system including observer, resolver, recorder, analyst, and coach roles for tracking and improving Wanma Code usage",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/usage-observer",
        "./skills/usage-resolver",
        "./skills/usage-recorder",
        "./skills/usage-analyst",
        "./skills/usage-coach",
        "./skills/usage-memory-analyzer"
      ]
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "py -3 \"${WANMA_PLUGIN_ROOT}/hooks/session_resumer.py\" 2>/dev/null || python3 \"${WANMA_PLUGIN_ROOT}/hooks/session_resumer.py\" 2>/dev/null || python \"${WANMA_PLUGIN_ROOT}/hooks/session_resumer.py\"",
        "description": "会话继续时恢复问题追踪状态，从 summary 中识别未解决的问题并恢复到 tracking_state.json"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "py -3 \"${WANMA_PLUGIN_ROOT}/hooks/keyword_router.py\" 2>/dev/null || python3 \"${WANMA_PLUGIN_ROOT}/hooks/keyword_router.py\" 2>/dev/null || python \"${WANMA_PLUGIN_ROOT}/hooks/keyword_router.py\"",
        "description": "检测用户输入中的问题关键词，创建追踪记录并引导 Wanma 委托 problem-tracker agent"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "py -3 \"${WANMA_PLUGIN_ROOT}/hooks/stop_recorder.py\" 2>/dev/null || python3 \"${WANMA_PLUGIN_ROOT}/hooks/stop_recorder.py\" 2>/dev/null || python \"${WANMA_PLUGIN_ROOT}/hooks/stop_recorder.py\"",
        "description": "Wanma 回复完成后，自动将活动问题记录到当天日期的 md 文件"
      }
    ]
  }
}
