{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_resumer.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_resumer.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_resumer.py\"",
            "description": "会话继续时，记录今天未解决的问题或继续跟踪"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/keyword_router.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/keyword_router.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/keyword_router.py\"",
            "description": "检测用户输入中的问题关键词，创建追踪记录并自动触发 usage-observer skill"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_recorder.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_recorder.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_recorder.py\"",
            "description": "Claude 回复完成后，自动将活动问题记录到当天日期的 md 文件"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_ender.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_ender.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_ender.py\"",
            "description": "会话结束时，将活动问题记录到日期 md 文件"
          }
        ]
      }
    ]
  }
}