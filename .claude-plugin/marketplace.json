{
  "name": "claude-usage-analysis-plugin",
  "owner": {
    "name": "zhangj1164",
    "email": "2430236902@qq.com"
  },
  "metadata": {
    "description": "Claude Code 使用分析系统 - 帮助团队自动采集、分析使用数据，持续优化 Claude Code 使用体验的完整解决方案",
    "version": "2.0.0",
    "tags": [
      "analytics",
      "productivity",
      "team",
      "monitoring",
      "improvement"
    ],
    "icon": "./assets/icon.svg"
  },
  "plugins": [
    {
      "name": "usage-analytics",
      "description": "Complete usage analytics system including observer, resolver, recorder, analyst, and coach roles for tracking and improving Claude Code usage",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/usage-observer",
        "./skills/usage-resolver",
        "./skills/usage-recorder",
        "./skills/usage-analyst",
        "./skills/usage-coach"
      ]
    }
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/keyword_router.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/keyword_router.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/keyword_router.py\"",
        "description": "检测用户输入中的问题关键词，创建追踪记录并引导 Claude 委托 problem-tracker agent"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_recorder.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_recorder.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_recorder.py\"",
        "description": "Claude 回复完成后，自动将活动问题记录到当天日期的 md 文件"
      }
    ]
  }
}
